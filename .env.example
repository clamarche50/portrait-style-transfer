# Runtime mode and public origins
APP_ENV=development
EXPOSE_API_DOCS=false
EXPOSE_METRICS=false
RATE_LIMIT_FAIL_CLOSED=true
APP_BASE_URL=https://localhost
API_BASE_URL=http://api:8000
PUBLIC_API_BASE_URL=/api/v1
# Used only by direct `npm run dev`; the container build uses same-origin `/api/v1` through Caddy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# PostgreSQL
POSTGRES_DB=portrait_transfer
POSTGRES_USER=portrait
POSTGRES_PASSWORD=replace-this-development-password
DATABASE_URL=postgresql+psycopg://portrait:replace-this-development-password@postgres:5432/portrait_transfer

# Redis and Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# S3-compatible storage
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=portrait-local
S3_SECRET_ACCESS_KEY=replace-this-minio-password
S3_BUCKET=portrait-private
S3_FORCE_PATH_STYLE=true
# Local MinIO has encrypted storage at the volume layer; production validation requires AES256 or aws:kms.
S3_SERVER_SIDE_ENCRYPTION=none
S3_KMS_KEY_ID=
MINIO_ROOT_USER=portrait-local
MINIO_ROOT_PASSWORD=replace-this-minio-password
SIGNED_URL_TTL_SECONDS=600

# Retention and resource limits
ASSET_TTL_HOURS=24
MAX_UPLOAD_BYTES=15728640
MAX_DECODED_PIXELS=8000000
MAX_ORIGINAL_LONG_EDGE=8000
MAX_SESSION_UPLOAD_BYTES_24H=104857600
MAX_ASSETS_PER_SESSION=100
MAX_CONCURRENT_JOBS_PER_USER=2
WORKER_TASK_TIME_LIMIT_SECONDS=900
WORKER_MEMORY_LIMIT=5G
MAX_JOB_CACHE_BYTES=536870912
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_UPLOADS_PER_HOUR=20
RATE_LIMIT_JOBS_PER_HOUR=30
REDIS_PROGRESS_TTL_SECONDS=172800
JOB_LOCK_TTL_SECONDS=3600

# Models. Binaries are downloaded explicitly by scripts/download_models.py.
# Compose fixes `/app/models` and the two MediaPipe filenames, then mounts only
# those exact files.
REQUIRE_MODELS_FOR_READINESS=true

# Algorithm/runtime
# The CPU Celery worker orchestrates an internal GPU inference sidecar. Leave
# ENABLE_GPU=false unless intentionally running the legacy dense-alignment worker.
ENABLE_GPU=false
DENSE_ALIGNMENT_DEVICE=cpu
DEFAULT_ALGORITHM_PROFILE=ai_dgpst_v1
ENABLE_SOURCE_COMPAT_PROFILE=false
# Heuristic analysis is explicit, non-production, and intended for synthetic smoke tests only.
ALLOW_HEURISTIC_ANALYZER=false

# Internal DGPST AI engine. Do not publish port 8010 or route Cloudflare to it.
AI_ENGINE_URL=http://ai-engine:8010
AI_ENGINE_REQUEST_TIMEOUT_SECONDS=600
# Required in production; use the same random value in the worker and sidecar.
AI_ENGINE_API_TOKEN=
AI_ENGINE_MEMORY_LIMIT=10G
AI_ENGINE_MAX_UPLOAD_BYTES=15728640
# Official DGPST scales the short side to 512; cap the long side for a 12 GB GPU.
DGPST_MAX_LONG_SIDE=768
# Model paths, CUDA/float16 mode, and mandatory verification remain fixed
# container invariants in compose.yml rather than host-configurable knobs.

# Local, ignored research workspace
REFERENCE_ARCHIVE_FILE=
REFERENCE_SOURCE_DIR=reference/original-matlab

# Browser/session security. Use long random values outside development.
CORS_ORIGINS=https://localhost,http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_MAX_AGE_SECONDS=604800

# Logging and privacy-safe optional OTLP/HTTP tracing. A blank endpoint disables tracing.
# Set a collector base URL (the services append /v1/traces) or a full /v1/traces URL.
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=

# Caddy
APP_HOST=localhost
CADDY_HTTPS_PORT=443
API_HOST_PORT=8000
WEB_HOST_PORT=3000
MINIO_CONSOLE_PORT=9001
CADDY_HTTP_PORT=80
