# syntax=docker/dockerfile:1.7
FROM ghcr.io/astral-sh/uv:0.11.18 AS uv
FROM python:3.12.10-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_PROJECT_ENVIRONMENT=/opt/venv PATH=/opt/venv/bin:$PATH
RUN groupadd --system app && useradd --system --gid app --home-dir /app app
WORKDIR /app
COPY --from=uv /uv /usr/local/bin/uv
COPY packages/portrait_transfer ./packages/portrait_transfer
COPY services/api ./services/api
RUN uv sync --project services/api --frozen --no-dev && chown -R app:app /app /opt/venv
USER app
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--app-dir", "services/api", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
