# syntax=docker/dockerfile:1.7

FROM python:3.12.10-slim-bookworm@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db AS runtime

ARG PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu128

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    XDG_CACHE_HOME=/tmp/.cache \
    HF_HOME=/tmp/huggingface \
    TORCH_HOME=/tmp/torch \
    CUDA_MODULE_LOADING=LAZY \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    PYTHONPATH=/app

RUN apt-get update \
    && apt-get install --yes --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app \
    && useradd --system --gid app --home-dir /app app

WORKDIR /app

COPY services/ai_engine/requirements.txt /app/services/ai_engine/requirements.txt
# insightface is installed first with --no-deps and stays out of
# requirements.txt: its declared opencv-python dependency conflicts with the
# headless OpenCV build pinned in requirements. That one skipped metadata
# requirement is then removed from its dist-info so `pip check` remains an
# honest consistency gate (its other imports, including onnx, are pinned in
# requirements.txt).
RUN python -m pip install --no-deps insightface==1.0.1 \
    && sed -E -i \
        -e '/^Requires-Dist: opencv-python/d' \
        /usr/local/lib/python3.12/site-packages/insightface-1.0.1.dist-info/METADATA

RUN python -m pip install \
        --index-url "${PYTORCH_INDEX_URL}" \
        torch==2.10.0 \
        torchvision==0.25.0

RUN python -m pip install -r /app/services/ai_engine/requirements.txt

COPY services/ai_engine /app/services/ai_engine
RUN python -m pip check \
    && python -c "import diffusers, insightface, peft, transformers; import services.ai_engine.app" \
    && chown -R app:app /app

USER app
EXPOSE 8010

CMD ["python", "-m", "uvicorn", "services.ai_engine.app:app", "--host", "0.0.0.0", "--port", "8010", "--workers", "1", "--no-proxy-headers"]
